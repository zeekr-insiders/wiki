/* Zeekr Brand Colors & Theme - Authentic Australian Market Palette */
:root {
  /* Zeekr Primary Colors - Based on official Australian website (zeekrlife.com/en-au) */
  --zeekr-primary-dark: #24292b;      /* Primary brand colour - official Zeekr dark charcoal */
  --zeekr-primary-light: #f8f9fa;     /* Clean light background */
  --zeekr-accent-orange: #FF6B35;     /* Accent orange for highlights - used sparingly */
  --zeekr-secondary-orange: #FF8C42;  /* Secondary orange variant */
  --zeekr-subtle-orange: #FFF5F0;     /* Very subtle orange background */
  --zeekr-text-primary: #212529;      /* Primary text colour */
  --zeekr-text-secondary: #6c757d;    /* Secondary text colour */
  --zeekr-text-muted: #868e96;        /* Muted text colour */
  --zeekr-border-light: #dee2e6;      /* Light border colour */
  --zeekr-border-orange: rgba(255, 107, 53, 0.2);  /* Orange border accent */
  --zeekr-surface-white: #ffffff;     /* Pure white surface */
  --zeekr-surface-grey: #f8f9fa;      /* Light grey surface */
  --zeekr-warning: #FFC107;           /* Warning amber */
  --zeekr-success: #28a745;           /* Success green */

  /* SVG and diagram colours */
  --zeekr-electric-blue: var(--zeekr-accent-orange);  /* For vehicle diagrams */
  --zeekr-accent-cyan: var(--zeekr-secondary-orange); /* For dimension lines */

  /* Refined gradients based on official site aesthetic */
  --zeekr-subtle-gradient: linear-gradient(135deg, var(--zeekr-primary-dark) 0%, #2d3436 100%);
  --zeekr-accent-gradient: linear-gradient(135deg, var(--zeekr-accent-orange) 0%, var(--zeekr-secondary-orange) 100%);
  --zeekr-premium-gradient: linear-gradient(145deg, var(--zeekr-primary-dark) 0%, var(--zeekr-accent-orange) 100%);
}

/* Light theme overrides - Authentic Zeekr Australian site styling */
[data-md-color-scheme="default"] {
  --md-primary-fg-color: var(--zeekr-primary-dark);
  --md-primary-fg-color--light: var(--zeekr-text-secondary);
  --md-primary-fg-color--dark: var(--zeekr-primary-dark);
  --md-accent-fg-color: var(--zeekr-accent-orange);
  --md-accent-fg-color--transparent: var(--zeekr-subtle-orange);
  --md-default-bg-color: var(--zeekr-surface-white);
  --md-default-fg-color: var(--zeekr-text-primary);
}

/* Dark theme overrides - Premium dark aesthetic with controlled orange highlights */
[data-md-color-scheme="slate"] {
  --md-primary-fg-color: var(--zeekr-accent-orange);
  --md-primary-fg-color--light: var(--zeekr-secondary-orange);
  --md-primary-fg-color--dark: var(--zeekr-accent-orange);
  --md-accent-fg-color: var(--zeekr-secondary-orange);
  --md-accent-fg-color--transparent: rgba(255, 107, 53, 0.15);
  --md-default-bg-color: var(--zeekr-primary-dark);
  --md-default-fg-color: var(--zeekr-primary-light);
  --md-code-bg-color: #1a1e22;
}

/* Header - Sophisticated dark theme matching official Australian site */
.md-header {
  background: var(--zeekr-primary-dark);
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
  border-bottom: 1px solid var(--zeekr-border-light);
}

/* Header title with clean, modern typography inspired by ZeekrHeadline font */
.md-header__title {
  font-weight: 600;
  font-size: 1.1rem;
  color: var(--zeekr-surface-white);
  letter-spacing: 0.5px;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrHeadline', sans-serif;
}

/* Navigation tabs - Clean modern approach matching official site */
.md-tabs {
  background: var(--zeekr-surface-grey);
  border-bottom: 1px solid var(--zeekr-border-light);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.md-tabs__link {
  color: var(--zeekr-text-secondary);
  opacity: 0.8;
  font-weight: 500;
  transition: all 0.2s ease;
  letter-spacing: 0.3px;
  font-size: 0.9rem;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

.md-tabs__link--active {
  color: var(--zeekr-accent-orange);
  opacity: 1;
  font-weight: 600;
  position: relative;
}

.md-tabs__link--active::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--zeekr-accent-orange);
}

.md-tabs__link:hover {
  color: var(--zeekr-accent-orange);
  opacity: 1;
  transform: none;
}

/* Search styling - Clean modern approach */
.md-search__input {
  background-color: var(--zeekr-surface-white);
  border: 1px solid var(--zeekr-border-light);
  border-radius: 6px;
  transition: all 0.2s ease;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

.md-search__input:focus {
  border-color: var(--zeekr-accent-orange);
  box-shadow: 0 0 0 2px rgba(255, 107, 53, 0.1);
  background-color: var(--zeekr-surface-white);
}

/* Sidebar navigation - Modern clean styling */
.md-nav__link {
  color: inherit;
  transition: all 0.2s ease;
  font-weight: 400;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

.md-nav__link--active {
  color: var(--zeekr-accent-orange);
  font-weight: 600;
  border-left: 2px solid var(--zeekr-accent-orange);
  padding-left: 0.6rem;
}

.md-nav__link:hover {
  color: var(--zeekr-accent-orange);
  transform: none;
}

/* Buttons - Modern, sophisticated styling */
.md-button {
  background: var(--zeekr-accent-orange);
  color: var(--zeekr-surface-white);
  border: 1px solid var(--zeekr-accent-orange);
  border-radius: 6px;
  padding: 10px 20px;
  font-weight: 500;
  letter-spacing: 0.3px;
  transition: all 0.2s ease;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

.md-button:hover {
  background: var(--zeekr-secondary-orange);
  border-color: var(--zeekr-secondary-orange);
  transform: none;
  box-shadow: 0 2px 8px rgba(255, 107, 53, 0.2);
}

.md-button--primary {
  background: var(--zeekr-accent-orange);
  border-color: var(--zeekr-accent-orange);
}

/* Links with controlled orange accent */
.md-typeset a {
  color: var(--zeekr-accent-orange);
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: all 0.2s ease;
  font-weight: 400;
}

.md-typeset a:hover {
  color: var(--zeekr-secondary-orange);
  border-bottom-color: var(--zeekr-secondary-orange);
  text-decoration: none;
}

/* Code blocks - Clean modern theme */
.md-typeset .highlight {
  border-radius: 6px;
  border: 1px solid var(--zeekr-border-light);
  background: var(--zeekr-surface-grey);
}

.md-typeset .highlight .gp {
  color: var(--zeekr-accent-orange);
}

/* Custom admonitions with Zeekr orange palette */
.md-typeset .admonition.tip,
.md-typeset details.tip {
  border-color: var(--zeekr-success);
}

.md-typeset .tip > .admonition-title,
.md-typeset .tip > summary {
  background-color: rgba(76, 175, 80, 0.1);
  border-color: var(--zeekr-success);
}

.md-typeset .admonition.info,
.md-typeset details.info {
  border-color: var(--zeekr-accent-orange);
}

.md-typeset .info > .admonition-title,
.md-typeset .info > summary {
  background-color: var(--zeekr-subtle-orange);
  border-color: var(--zeekr-accent-orange);
}

.md-typeset .admonition.warning,
.md-typeset details.warning {
  border-color: var(--zeekr-warning);
}

.md-typeset .warning > .admonition-title,
.md-typeset .warning > summary {
  background-color: rgba(255, 193, 7, 0.1);
  border-color: var(--zeekr-warning);
}

/* Tables - Clean, professional styling */
.md-typeset table:not([class]) {
  border: 1px solid var(--zeekr-border-light);
  border-radius: 6px;
  overflow: hidden;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
}

.md-typeset table:not([class]) th {
  background: var(--zeekr-primary-dark);
  color: var(--zeekr-surface-white);
  font-weight: 600;
  letter-spacing: 0.3px;
  font-size: 0.9rem;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

.md-typeset table:not([class]) tr:hover {
  background-color: var(--zeekr-subtle-orange);
  transition: all 0.2s ease;
}

/* Search results - Refined orange highlights */
.md-search-result__article--document .md-search-result__title {
  color: var(--zeekr-accent-orange);
}

.md-search-result__teaser {
  color: inherit;
}

/* Footer styling - Clean modern theme */
.md-footer {
  background: var(--zeekr-surface-grey);
  border-top: 1px solid var(--zeekr-border-light);
}

.md-footer-meta {
  background: var(--zeekr-primary-dark);
  color: var(--zeekr-primary-light);
}

/* Scrollbar styling for dark theme - Refined accents */
[data-md-color-scheme="slate"] ::-webkit-scrollbar {
  width: 8px;
}

[data-md-color-scheme="slate"] ::-webkit-scrollbar-track {
  background: #1a1e22;
}

[data-md-color-scheme="slate"] ::-webkit-scrollbar-thumb {
  background: var(--zeekr-accent-orange);
  border-radius: 4px;
}

[data-md-color-scheme="slate"] ::-webkit-scrollbar-thumb:hover {
  background: var(--zeekr-secondary-orange);
}

/* Custom classes for Zeekr-specific styling - Modern automotive theme */
.zeekr-hero {
  background: var(--zeekr-premium-gradient);
  color: var(--zeekr-surface-white);
  padding: 2rem;
  border-radius: 8px;
  text-align: center;
  margin: 2rem 0;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  border: 1px solid rgba(255, 107, 53, 0.2);
}

.zeekr-card {
  background: var(--zeekr-subtle-orange);
  border: 1px solid var(--zeekr-border-orange);
  border-radius: 8px;
  padding: 1.5rem;
  margin: 1rem 0;
  transition: all 0.2s ease;
}

.zeekr-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(255, 107, 53, 0.1);
  border-color: var(--zeekr-accent-orange);
  background: rgba(255, 107, 53, 0.08);
}

.zeekr-spec-table {
  background: var(--zeekr-surface-grey);
  border-radius: 6px;
  overflow: hidden;
  border: 1px solid var(--zeekr-border-light);
}

.zeekr-highlight {
  background: var(--zeekr-subtle-orange);
  padding: 0.2rem 0.5rem;
  border-radius: 4px;
  color: var(--zeekr-accent-orange);
  font-weight: 600;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

/* Animation for loading states - Refined glow */
@keyframes zeekrGlow {
  0%, 100% {
    box-shadow: 0 0 5px var(--zeekr-accent-orange);
  }
  50% {
    box-shadow: 0 0 20px var(--zeekr-accent-orange), 0 0 30px var(--zeekr-secondary-orange);
  }
}

@keyframes zeekrPulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 8px rgba(255, 107, 53, 0.1);
  }
  50% {
    transform: scale(1.01);
    box-shadow: 0 0 16px rgba(255, 107, 53, 0.2);
  }
}

.zeekr-glow {
  animation: zeekrGlow 2s ease-in-out infinite;
}

.zeekr-pulse {
  animation: zeekrPulse 3s ease-in-out infinite;
}

/* Mobile optimizations */
@media screen and (max-width: 768px) {
  .md-header__title {
    font-size: 1rem;
  }

  .zeekr-hero {
    padding: 1.5rem;
    margin: 1rem 0;
  }

  .zeekr-card {
    padding: 1rem;
  }
}

/* ============================================================================
   ZEEKR COMPARISON TABLE STYLES
   ============================================================================ */

/* Three-column variant comparison grid */
.zeekr-comparison-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2rem;
  margin: 2rem 0;
}

.zeekr-variant-card {
  background: var(--zeekr-surface-white);
  border: 1px solid var(--zeekr-border-light);
  border-radius: 8px;
  overflow: hidden;
  transition: all 0.3s ease;
  position: relative;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.zeekr-variant-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  border-color: var(--zeekr-accent-orange);
  background: var(--zeekr-subtle-orange);
}

.variant-hero {
  position: relative;
  height: 240px;
  overflow: hidden;
  background: var(--zeekr-primary-dark);
  border-bottom: 1px solid var(--zeekr-border-light);
}

.variant-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.zeekr-variant-card:hover .variant-image {
  transform: scale(1.05);
}

.variant-content {
  padding: 1.5rem;
}

.variant-name {
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--zeekr-accent-orange);
  margin: 0 0 0.5rem 0;
  text-align: center;
  letter-spacing: 0.3px;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrHeadline', sans-serif;
}

.variant-tagline {
  text-align: center;
  color: var(--zeekr-text-secondary);
  font-size: 0.9rem;
  margin-bottom: 1.5rem;
  opacity: 0.8;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

.variant-specs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.spec-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.spec-label {
  font-size: 0.8rem;
  color: var(--zeekr-text-secondary);
  opacity: 0.8;
  margin-bottom: 0.25rem;
  text-transform: uppercase;
  letter-spacing: 0.3px;
  font-weight: 500;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

.spec-value {
  font-size: 1rem;
  font-weight: 600;
  color: var(--zeekr-accent-orange);
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

.variant-pricing {
  text-align: center;
  padding-top: 1rem;
  border-top: 1px solid var(--zeekr-border-light);
  background: var(--zeekr-surface-grey);
}

.price-label {
  display: block;
  font-size: 0.8rem;
  color: var(--zeekr-text-secondary);
  opacity: 0.8;
  text-transform: uppercase;
  margin-bottom: 0.25rem;
  letter-spacing: 0.3px;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

.price-value {
  font-size: 1.6rem;
  font-weight: 700;
  color: var(--zeekr-accent-orange);
  display: block;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrHeadline', sans-serif;
}

/* Dimensions section */
.zeekr-dimensions-section {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 2rem;
  margin: 2rem 0;
  align-items: center;
}

.dimensions-visual {
  background: var(--zeekr-surface-white);
  border: 1px solid var(--zeekr-border-light);
  border-radius: 8px;
  padding: 2rem;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.dimension-diagram {
  width: 100%;
  height: auto;
  max-height: 300px;
}

.dimension-label {
  fill: var(--zeekr-accent-orange);
  font-size: 12px;
  font-weight: 500;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

.wheelbase-label {
  fill: var(--zeekr-secondary-orange);
  font-size: 14px;
  font-weight: 600;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

.dimensions-specs {
  background: var(--zeekr-surface-white);
  border: 1px solid var(--zeekr-border-light);
  border-radius: 8px;
  padding: 1.5rem;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.dimension-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
}

.dimension-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.75rem 0;
  border-bottom: 1px solid var(--zeekr-border-light);
  transition: all 0.2s ease;
}

.dimension-item:hover {
  background-color: var(--zeekr-subtle-orange);
  transform: translateX(2px);
}

.dimension-item:last-child {
  border-bottom: none;
}

.dimension-label {
  font-size: 0.9rem;
  color: var(--zeekr-text-secondary);
  opacity: 0.8;
  font-weight: 500;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

.dimension-value {
  font-size: 1rem;
  font-weight: 600;
  color: var(--zeekr-accent-orange);
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

/* Comparison tables */
.comparison-table {
  width: 100%;
  border-collapse: collapse;
  margin: 1rem 0;
  background: transparent;
}

.comparison-table th {
  background: var(--zeekr-primary-dark);
  color: var(--zeekr-surface-white);
  padding: 1rem;
  text-align: center;
  font-weight: 600;
  font-size: 0.9rem;
  letter-spacing: 0.3px;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

.comparison-table td {
  padding: 0.75rem 1rem;
  text-align: center;
  border-bottom: 1px solid var(--zeekr-border-light);
  transition: all 0.2s ease;
  font-weight: 500;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

.comparison-table tr:hover td {
  background-color: var(--zeekr-subtle-orange);
  transform: none;
}

.spec-category {
  font-weight: 600;
  text-align: left !important;
  color: var(--zeekr-accent-orange);
  background: var(--zeekr-subtle-orange) !important;
  text-transform: uppercase;
  letter-spacing: 0.3px;
  font-size: 0.85rem;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

/* Warranty section */
.warranty-section {
  margin: 2rem 0;
}

.warranty-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
  margin: 1.5rem 0;
}

.warranty-card {
  text-align: center;
  padding: 2rem 1.5rem;
}

.warranty-card h3 {
  color: var(--zeekr-accent-orange);
  margin: 0 0 1rem 0;
  font-size: 1.2rem;
  letter-spacing: 0.3px;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrHeadline', sans-serif;
}

.warranty-term {
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--zeekr-secondary-orange);
  margin: 0.5rem 0 1rem 0;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrHeadline', sans-serif;
}

.warranty-card p {
  margin: 0;
  opacity: 0.8;
  font-size: 0.9rem;
}

/* State pricing sections */
.pricing-state-section {
  margin: 2rem 0;
}

.pricing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
  margin: 1.5rem 0;
}

.pricing-card {
  padding: 1.5rem;
}

.pricing-card h4 {
  color: var(--zeekr-accent-orange);
  margin: 0 0 1rem 0;
  text-align: center;
  font-size: 1.1rem;
  letter-spacing: 0.3px;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrHeadline', sans-serif;
}

.price-breakdown {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.5rem 0;
  border-bottom: 1px solid var(--zeekr-border-light);
  font-size: 0.9rem;
  transition: all 0.2s ease;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

.price-item:hover {
  background-color: var(--zeekr-subtle-orange);
  transform: translateX(2px);
}

.price-item:last-of-type {
  border-bottom: none;
}

.price-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 0 0.5rem 0;
  border-top: 2px solid var(--zeekr-accent-orange);
  margin-top: 0.5rem;
  font-weight: 600;
  background: var(--zeekr-subtle-orange);
  border-radius: 4px;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

.price-total .zeekr-highlight {
  font-size: 1.2rem;
}

.incentives-info {
  margin-top: 2rem;
  padding: 1.5rem;
}

.incentives-info h4 {
  color: var(--zeekr-accent-orange);
  margin: 0 0 1rem 0;
  letter-spacing: 0.3px;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrHeadline', sans-serif;
}

.incentives-info ul {
  margin: 0;
  padding-left: 1.5rem;
}

.incentives-info li {
  margin-bottom: 0.5rem;
  font-size: 0.9rem;
}

.incentives-info strong {
  color: var(--zeekr-secondary-orange);
}

/* Mobile responsiveness */
@media screen and (max-width: 768px) {
  .zeekr-comparison-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .zeekr-dimensions-section {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .dimension-diagram {
    max-height: 200px;
  }

  .variant-specs {
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .spec-item {
    flex-direction: row;
    justify-content: space-between;
    text-align: left;
  }

  .comparison-table {
    font-size: 0.8rem;
  }

  .comparison-table th,
  .comparison-table td {
    padding: 0.5rem 0.25rem;
  }

  .warranty-grid,
  .pricing-grid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .variant-name {
    font-size: 1.2rem;
  }

  .price-value {
    font-size: 1.4rem;
  }
}

@media screen and (max-width: 480px) {
  .variant-hero {
    height: 180px;
  }

  .variant-content {
    padding: 1rem;
  }

  .dimensions-visual,
  .dimensions-specs {
    padding: 1rem;
  }

  .warranty-card,
  .pricing-card {
    padding: 1rem;
  }

  .comparison-table th,
  .comparison-table td {
    padding: 0.4rem 0.2rem;
    font-size: 0.75rem;
  }
}

/* Dark theme adjustments - Refined automotive dark theme */
[data-md-color-scheme="slate"] .zeekr-variant-card {
  background: rgba(255, 107, 53, 0.05);
  border-color: rgba(255, 107, 53, 0.2);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
}

[data-md-color-scheme="slate"] .dimensions-visual,
[data-md-color-scheme="slate"] .dimensions-specs {
  background: rgba(255, 107, 53, 0.05);
  border-color: rgba(255, 107, 53, 0.2);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
}

[data-md-color-scheme="slate"] .comparison-table tr:hover td {
  background-color: rgba(255, 107, 53, 0.08);
}

[data-md-color-scheme="slate"] .spec-category {
  background: rgba(255, 107, 53, 0.08) !important;
}

/* Additional dark theme enhancements */
[data-md-color-scheme="slate"] .zeekr-card {
  background: rgba(255, 107, 53, 0.05);
  border-color: rgba(255, 107, 53, 0.2);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
}

[data-md-color-scheme="slate"] .zeekr-hero {
  background: var(--zeekr-premium-gradient);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(255, 107, 53, 0.3);
}

[data-md-color-scheme="slate"] .zeekr-spec-table {
  background: rgba(0, 0, 0, 0.2);
  border-color: rgba(255, 107, 53, 0.2);
}

/* Premium automotive enhancements */
.zeekr-premium-badge {
  background: var(--zeekr-accent-orange);
  color: var(--zeekr-surface-white);
  padding: 0.3rem 0.8rem;
  border-radius: 16px;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.3px;
  box-shadow: 0 2px 6px rgba(255, 107, 53, 0.2);
  display: inline-block;
  margin: 0.25rem;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

.zeekr-accent-divider {
  height: 2px;
  background: var(--zeekr-accent-gradient);
  border-radius: 1px;
  margin: 2rem 0;
  box-shadow: 0 1px 3px rgba(255, 107, 53, 0.2);
}

.zeekr-performance-meter {
  background: linear-gradient(90deg,
    var(--zeekr-primary-dark) 0%,
    var(--zeekr-accent-orange) 30%,
    var(--zeekr-secondary-orange) 60%,
    var(--zeekr-accent-orange) 100%);
  height: 8px;
  border-radius: 4px;
  position: relative;
  overflow: hidden;
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.2);
}

.zeekr-performance-meter::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg,
    transparent,
    rgba(255, 255, 255, 0.4),
    transparent);
  animation: shimmer 2s infinite;
}

@keyframes shimmer {
  0% { left: -100%; }
  100% { left: 100%; }
}

/* Automotive specification styling */
.zeekr-spec-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
  margin: 1.5rem 0;
}

.zeekr-spec-item {
  background: var(--zeekr-subtle-orange);
  border: 1px solid var(--zeekr-border-orange);
  border-radius: 6px;
  padding: 1rem;
  text-align: center;
  transition: all 0.2s ease;
}

.zeekr-spec-item:hover {
  transform: translateY(-1px);
  background: rgba(255, 107, 53, 0.08);
  box-shadow: 0 4px 12px rgba(255, 107, 53, 0.1);
}

.zeekr-spec-title {
  font-size: 0.8rem;
  color: var(--zeekr-text-secondary);
  opacity: 0.8;
  text-transform: uppercase;
  letter-spacing: 0.3px;
  margin-bottom: 0.5rem;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

.zeekr-spec-data {
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--zeekr-accent-orange);
  line-height: 1.2;
  font-family: system-ui, -apple-system, 'Segoe UI', 'ZeekrText', sans-serif;
}

/* Print styles */
@media print {
  .md-header,
  .md-tabs,
  .md-sidebar,
  .md-footer {
    display: none !important;
  }

  .md-content {
    margin: 0 !important;
  }

  .zeekr-comparison-grid {
    display: block;
  }

  .zeekr-variant-card {
    break-inside: avoid;
    margin-bottom: 2rem;
  }

  .comparison-table {
    break-inside: avoid;
  }
}

/* Enhanced mobile responsiveness for new elements */
@media screen and (max-width: 480px) {
  .zeekr-spec-grid {
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .zeekr-spec-item {
    padding: 0.75rem;
  }

  .zeekr-premium-badge {
    font-size: 0.7rem;
    padding: 0.25rem 0.6rem;
  }

  .zeekr-performance-meter {
    height: 6px;
  }
}

/* Authentic Australian Zeekr brand theme - Australian English */
/*
 * This stylesheet accurately reflects Zeekr's official Australian market identity:
 * - Primary brand colour: Dark charcoal (#24292b) matching zeekrlife.com/en-au
 * - Accent colour: Speed Orange (#FF6B35) used sparingly for highlights
 * - Typography: System fonts with ZeekrHeadline and ZeekrText inspiration
 * - Design language: Clean, modern, sophisticated approach like official site
 * - Refined interactions: Subtle hover effects without excessive animations
 * - Professional automotive aesthetic: Premium yet accessible presentation
 * - Mobile-first responsive design optimised for Australian users
 * - Consistent with official Zeekr Australian website design principles
 */